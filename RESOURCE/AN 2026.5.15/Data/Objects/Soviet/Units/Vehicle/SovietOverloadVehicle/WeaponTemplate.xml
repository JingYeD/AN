	<WeaponTemplate
		id="ScatterableWeapon">
		<ScatterRadiusVsType
			Radius="70.0"
			RequiredModelConditions="SHRINK_EFFECT">
			<Filter
				Rule="ANY"
				Include="INFANTRY AIRCRAFT VEHICLE HUGE_VEHICLE" />
		</ScatterRadiusVsType>
		<ScatterRadiusVsType
			Radius="70.0"
			RequiredModelConditions="SPECIAL_POWER_2">
			<Filter
				Rule="NONE">
				<IncludeThing>JapanAntiVehicleVehicleTech1</IncludeThing>
			</Filter>
		</ScatterRadiusVsType>
	</WeaponTemplate>
	<WeaponTemplate
		id="SovietOverloadVehicleCannonWeapon"
		inheritFrom="ScatterableWeapon"
		AttackRange="300.0"
		MinimumAttackRange="50"
		WeaponSpeed="2000"
		WeaponRecoil="2d"
		FireFX="FX_SovietMARVCannon"
		FireVeteranFX="FX_SovietMARVCannonVet"
		FireSound="SOV_ApocalypseTank_CannonFire"
		ClipSize="2"
		ShotsPerBarrel="1"
		ReAcquireDetailType="PRE_FIRE"
		Flags="ATTACK_NEEDS_LINE_OF_SIGHT"
		ProjectileCollidesWith="ALLIES ENEMIES NEUTRAL STRUCTURES WALLS"
		RequiredAntiMask="ANTI_GROUND ANTI_STRUCTURE ANTI_WATER"
		RadiusDamageAffects="ENEMIES"
		CanFireWhileMoving="true">
		<FiringDuration
			MinSeconds="1.5s"
			MaxSeconds="1.5s" />
		<ClipReloadTime
			MinSeconds="4s"
			MaxSeconds="4s" />
		<Nuggets>
			<ProjectileNugget
				ProjectileTemplate="SovietEpicTank3HarpoonProjectile"
				WarheadTemplate="SovietOverloadVehicleCannonWeaponWarhead">
				<VeterancyProjectiles
					VeterancyLevel="HEROIC"
					ProjectileTemplate="SovietEpicTank3HarpoonProjectileVet"/>		
			</ProjectileNugget>
			<!--SovietEpicTank3HarpoonProjectileDummy-->
			<SuppressionNugget
				Radius="75.0"
				Suppression="75"
				DurationSeconds="2s" />
		</Nuggets>
	</WeaponTemplate>
	<WeaponTemplate
		id="SovietOverloadVehicleCannonWeaponWarhead"
		ProjectileCollidesWith="ALLIES ENEMIES NEUTRAL STRUCTURES WALLS"
		RadiusDamageAffects="ALLIES ENEMIES NEUTRALS"
        Flags="ATTACK_NEEDS_LINE_OF_SIGHT NOT_ATTRACTED_BY_MAGNETS"
		RequiredAntiMask="ANTI_GROUND ANTI_STRUCTURE ANTI_WATER">
		<Nuggets>
			<DamageNugget
				Damage="400.0"
				DamageTaperOff="200"
				Radius="30.0"
				DamageType="CANNON"
				DamageFXType="SOVIET_CANNON"
				DeathType="EXPLODED" >
				<DamageScalarDetails Scalar= "100%">
					<Filter
					     Rule="ANY"
					     Include="INFANTRY">
					</Filter>
				</DamageScalarDetails>
				<DamageScalarDetails Scalar= "100%">
					<Filter
					Rule="NONE">
						<IncludeThing>JapanAntiStructureVehicle</IncludeThing>
						<IncludeThing>SovietAntiStructureVehicle</IncludeThing>
						<IncludeThing>AlliedAntiStructureVehicle</IncludeThing>
						<IncludeThing>AlliedArtilleryVehicle</IncludeThing>
					</Filter>
				</DamageScalarDetails>
			</DamageNugget>
			<MetaImpactNugget
					ShockWaveAmount="50.0"
					ShockWaveRadius="15.0"
					ShockWaveZMult="1" />
		</Nuggets>
	</WeaponTemplate>

