	<GameObject
		id="SovietEpicTank3HarpoonProjectile"
		Side="Soviet"
		EditorSorting="SYSTEM"
		KindOf="PROJECTILE NO_COLLIDE HIDE_IF_FOGGED"
		EditorName="SovietEpicTank3HarpoonProjectile">
		<ArmorSet
			Armor="NoArmor" />
		<Draws>
			<ScriptedModelDraw
				id="ModuleTag_ScriptedModelDraw">
				<ModelConditionState
					ParseCondStateType="PARSE_DEFAULT">
					<Model
						Name="SovietAntiVehicleVehicleTech3TankTankShell" />
					<ParticleSysBone
						BoneName="FX_Trail01"
						FXParticleSystemTemplate="EpicCaliberGunTrail"
						FollowBone="true" />
					<ParticleSysBone
						BoneName="FX_Trail02"
						FXParticleSystemTemplate="EpicCaliberGunTrail"
						FollowBone="true" />
				</ModelConditionState>
			</ScriptedModelDraw>
		</Draws>
		<Behaviors>
			<DestroyDie
				id="ModuleTag_Die">
				<DieMuxData
					DeathTypes="ALL" />
			</DestroyDie>
			<FXListBehavior
				id="ModuleTag_FXLists">
				<DieMuxData
					DeathTypes="ALL" />
				<Event
					Index="onDeath"
					FX="FX_SovietEpicTank3Explosion" />
				<Event
					Index="onTerrainCollision"
					FX="FX_SovietEpicTank3Explosion"/>
			</FXListBehavior>
			<BezierProjectile
				id="ModuleTag_BezierProjectileBehavior"
				Flags="ORIENT_TO_FLIGHT_PATH DETONATE_CALLS_KILL"
				FirstHeightMin="0"
				FirstHeightMax="0"
				SecondHeightMin="0"
				SecondHeightMax="0"
				FirstPercentIndent="0"
				SecondPercentIndent="0"
				CurveFlattenMinDist="300"
				FlightPathAdjustDistPerSecond="0"
				GroundHitFX="">
			</BezierProjectile>
		</Behaviors>
		<Body>
			<ActiveBody
				id="ModuleTag_ActiveBody"
				MaxHealth="100.0" />
		</Body>
		<Geometry
			IsSmall="true">
			<Shape
				Type="SPHERE"
				MajorRadius="0.8">
			</Shape>
		</Geometry>
		<VisionInfo
			VisionRange="0" />
	</GameObject>
