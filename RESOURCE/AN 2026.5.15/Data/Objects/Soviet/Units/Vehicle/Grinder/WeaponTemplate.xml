		Flags="NOT_ATTRACTED_BY_MAGNETS IGNORE_TARGET_AS_OBSTACLE"
		RequiredAntiMask="ANTI_VEHICLE ANTI_STRUCTURE ANTI_WATER"
		ForbiddenAntiMask="ANTI_INFANTRY ANTI_AIRBORNE_INFANTRY ANTI_AIRBORNE_VEHICLE ANTI_LIFTED_GROUND_UNIT ANTI_SUBMERGED"
		InstantLoadClipOnActivate="true"
		FinishAttackOnceStarted="true"
		IgnoresContactPoints="true"
		MeleeWeapon="true"
		ContactWeapon="true"
		ChaseWeapon="true">
		<FiringDuration
			MinSeconds="0.12s"
			MaxSeconds="0.12s" />
		<ClipReloadTime
			MinSeconds="0.12s"
			MaxSeconds="0.12s" />
		<Nuggets>
